# ============================================================================
# Smart Parking System - Environment Variables Template
# Copy this file to .env and adjust variables as per your local/production environment
# NEVER commit the actual .env file or sensitive credentials to version control
# ============================================================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL 8+)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=parking_system_db
DB_USERNAME=root
DB_PASSWORD=root

# Security & JWT Configuration (Must be at least 256-bit / 32 characters in production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Configuration (Frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Logging Level
LOG_LEVEL_SMARTPARKING=DEBUG
